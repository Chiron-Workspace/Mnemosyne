# =============================================================================
# Mnemosyne Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# =============================================================================

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# PostgreSQL connection string. Mnemosyne uses the same local Postgres cluster
# as the Knowledge Store (chiron-ks-postgres.service, port 55432) but its OWN
# database — KS and Mnemosyne are independent modules and their schemas must
# not mix. Shared instance to avoid operating two servers, not shared data.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/mnemosyne

# --------------------------------------------------------------------------
# LLM (DeepSeek)
# --------------------------------------------------------------------------
# DeepSeek API key for AI tutor functionality.
DEEPSEEK_API_KEY=your-deepseek-key-here
# Model identifier for the DeepSeek chat completion API.
DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------------------------------
# Knowledge Store (KS)
# --------------------------------------------------------------------------
# Bearer token for the Knowledge Store HTTP API (localhost only). Must match
# the token the KS service (chiron-ks-http.service) is configured with.
# OPTIONAL: if left empty, Mnemosyne logs a warning at startup and skips
# transcript sync. Study sessions run normally either way.
KS_HTTP_TOKEN=
# Port override for the Knowledge Store. Defaults to 8080 when unset.
KS_HTTP_PORT=8080

# --------------------------------------------------------------------------
# Deployment (optional - used for Vercel or similar platforms)
# --------------------------------------------------------------------------
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
