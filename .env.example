# =============================================================================
# Mnemosyne Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# =============================================================================

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# PostgreSQL connection string for the application database.
DATABASE_URL=postgresql://user:password@localhost:5432/mnemosyne

# Supabase project URL and anonymous key (safe for client-side use).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------------------------------
# LLM (DeepSeek)
# --------------------------------------------------------------------------
# DeepSeek API key for AI tutor functionality.
DEEPSEEK_API_KEY=your-deepseek-key-here
# Model identifier for the DeepSeek chat completion API.
DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------------------------------
# Deployment (optional - used for Vercel or similar platforms)
# --------------------------------------------------------------------------
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
